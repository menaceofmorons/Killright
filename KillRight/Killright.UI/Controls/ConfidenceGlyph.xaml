<UserControl x:Class="Killright.UI.Controls.ConfidenceGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="12"
             Height="12"
             SnapsToDevicePixels="True">
    <Grid Width="12" Height="12">
        <Rectangle x:Name="FullFill"
                   Width="12"
                   Height="12"
                   Fill="{DynamicResource Brush.Confidence.Fill}"
                   Visibility="Collapsed" />
        <Rectangle x:Name="BottomHalfFill"
                   Width="12"
                   Height="6"
                   VerticalAlignment="Bottom"
                   Fill="{DynamicResource Brush.Confidence.Fill}"
                   Visibility="Collapsed" />
        <Rectangle x:Name="RingOutline"
                   Width="12"
                   Height="12"
                   Stroke="{DynamicResource Brush.Confidence.Fill}"
                   StrokeThickness="1"
                   Fill="Transparent"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
