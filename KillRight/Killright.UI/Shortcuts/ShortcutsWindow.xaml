<Window x:Class="Killright.UI.Shortcuts.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Killright.UI.Controls"
        xmlns:resources="clr-namespace:Killright.UI.Resources"
        Title="{x:Static resources:UiText.WindowTitleShortcuts}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Killright.UI;component/Theme/ChromeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="HelpContentInset">12</Thickness>
            <Style x:Key="HelpParagraph" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom"
                Content="{x:Static resources:UiText.ShortcutsButtonClose}"
                Width="80"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="Close_Click" />
        <TabControl>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabShortcuts}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ShortcutGroups}" Margin="{StaticResource HelpContentInset}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,2">
                                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="110" />
                                                    <TextBlock Text="{Binding Action}" TextWrapping="Wrap" Width="216" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource HelpContentInset}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeFleet}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{Binding StyleFleet}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeBlob}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{Binding StyleBlob}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeGang}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{Binding StyleGang}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeSolo}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleWordSolo}" />
                        </StackPanel>
                        <Rectangle Height="1"
                                   Width="160"
                                   Margin="0,12,0,8"
                                   HorizontalAlignment="Left"
                                   Stroke="Gray"
                                   StrokeThickness="1"
                                   StrokeDashArray="2,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeInactive}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleWordInactive}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleCodeVictim}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsStyleWordVictim}" />
                        </StackPanel>
                        <Rectangle Height="1"
                                   Width="160"
                                   Margin="0,12,0,8"
                                   HorizontalAlignment="Left"
                                   Stroke="Gray"
                                   StrokeThickness="1"
                                   StrokeDashArray="2,2" />
                        <TextBlock Text="{x:Static resources:UiText.ShortcutsSuffixHeading}" FontWeight="Bold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsSuffixBeginnerCode}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsSuffixBeginnerDescription}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsSuffixPodderCode}" FontWeight="Bold" Width="24" />
                            <TextBlock Text="{x:Static resources:UiText.ShortcutsSuffixPodderDescription}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabThreat}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource HelpContentInset}">
                        <TextBlock Text="{Binding ThreatIntro}" Style="{StaticResource HelpParagraph}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="None" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatNone}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="1" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatLow}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="2" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatMedium}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="3" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatHigh}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="4" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatVeryHigh}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ThreatGlyph Band="5" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ThreatExtreme}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Unk" Margin="0,0,10,0" />
                            <TextBlock Text="{x:Static resources:UiText.ThreatBandUnk}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabRelationship}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource HelpContentInset}">
                        <TextBlock Text="{Binding RelationshipIntro}" Style="{StaticResource HelpParagraph}" />
                        <TextBlock Text="{Binding RelationshipShown}" Style="{StaticResource HelpParagraph}" />
                        <TextBlock Text="{Binding RelationshipNumber}" Style="{StaticResource HelpParagraph}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ConfidenceGlyph Confidence="1" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding RelationshipLow}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:ConfidenceGlyph Confidence="2" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding RelationshipMedium}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:ConfidenceGlyph Confidence="3" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding RelationshipHigh}" TextWrapping="Wrap" Width="296" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource HelpContentInset}">
                        <TextBlock Text="{Binding GroupIntro}" Style="{StaticResource HelpParagraph}" />
                        <TextBlock Text="{Binding GroupDirect}" Style="{StaticResource HelpParagraph}" />
                        <TextBlock Text="{Binding GroupChain}" Style="{StaticResource HelpParagraph}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:UiText.ShortcutsTabAbout}">
                <StackPanel Margin="{StaticResource HelpContentInset}">
                    <TextBlock Text="{Binding AboutVersion}" Style="{StaticResource HelpParagraph}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
