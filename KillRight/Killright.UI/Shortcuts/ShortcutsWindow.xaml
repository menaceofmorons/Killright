<Window x:Class="Killright.UI.Shortcuts.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Killright.UI.Controls"
        Title="KillRight — Help"
        Width="420"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom"
                Content="Close"
                Width="80"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="Close_Click" />
        <TabControl>
            <TabItem Header="Shortcuts">
                <ListBox BorderThickness="0"
                         Background="Transparent"
                         Margin="0,8,0,0">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl+M" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Open menu" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl+Q" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Quit" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F1" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Show this help" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl+Shift+D" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Reveal/hide Developer tab (inside menu)" TextWrapping="Wrap" Width="230" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alt + drag" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Move window" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Win+Down" FontWeight="Bold" Width="120" />
                            <TextBlock Text="Minimize window" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </TabItem>
            <TabItem Header="Style">
                <ListBox BorderThickness="0"
                         Background="Transparent"
                         Margin="0,8,0,0">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="U" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Unknown" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="V" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Victim" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="S" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Solo" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Gang" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="B" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Blob" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Fleet" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="M" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Miner" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="E" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Explorer" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="H" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Hauler" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="P" FontWeight="Bold" Width="24" />
                            <TextBlock Text="PI" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="I" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Inactive" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="b" FontWeight="Bold" Width="24" />
                            <TextBlock Text="Suffix, indicates a Beginner in the main Style (e.g. Sb means Solo Beginner)." TextWrapping="Wrap" Width="320" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </TabItem>
            <TabItem Header="Threat">
                <ListBox BorderThickness="0"
                         Background="Transparent"
                         Margin="0,8,0,0">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="None" Margin="0,0,10,0" />
                            <TextBlock Text="None" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Low" Margin="0,0,10,0" />
                            <TextBlock Text="Low" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Medium" Margin="0,0,10,0" />
                            <TextBlock Text="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="High" Margin="0,0,10,0" />
                            <TextBlock Text="High" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Very High" Margin="0,0,10,0" />
                            <TextBlock Text="Very High" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Extreme" Margin="0,0,10,0" />
                            <TextBlock Text="Extreme" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <controls:ThreatGlyph Band="Unk" Margin="0,0,10,0" />
                            <TextBlock Text="Unk" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
