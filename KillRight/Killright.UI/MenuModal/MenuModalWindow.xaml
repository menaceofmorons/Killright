<Window x:Class="Killright.UI.MenuModal.MenuModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diagnostics="clr-namespace:Killright.UI.Diagnostics"
        Title="KillRight — Menu"
        Width="420"
        Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="Ok_Click" />
            <Button Content="Cancel"
                    Width="80"
                    Click="Cancel_Click" />
        </StackPanel>
        <TabControl x:Name="MenuTabControl"
                    SelectionChanged="MenuTabControl_SelectionChanged">
            <TabItem Header="Config">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              Content="Always on top"
                              Checked="AlwaysOnTop_Changed"
                              Unchecked="AlwaysOnTop_Changed" />
                    <CheckBox x:Name="SkipBackupOnCloseCheckBox"
                              Content="Skip Backup on Close"
                              Margin="0,8,0,0"
                              Checked="SkipBackupOnClose_Changed"
                              Unchecked="SkipBackupOnClose_Changed" />
                    <Button Content="Reset to Defaults"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Click="ResetToDefaults_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Appearance">
                <StackPanel Margin="12">
                    <TextBlock Text="Theme" />
                    <ComboBox x:Name="ThemeComboBox"
                              Margin="0,4,0,12"
                              SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Follow Windows" Tag="FollowWindows" />
                    </ComboBox>
                    <TextBlock Text="Grid Font Size" />
                    <ComboBox x:Name="FontTierComboBox"
                              Margin="0,4,0,12"
                              SelectionChanged="FontTier_Changed">
                        <ComboBoxItem Content="Large" Tag="Large" />
                        <ComboBoxItem Content="Medium" Tag="Medium" />
                        <ComboBoxItem Content="Small" Tag="Small" />
                        <ComboBoxItem Content="Tiny" Tag="Tiny" />
                    </ComboBox>
                    <TextBlock Text="Highlight Colours" />
                    <TextBlock Text="Pilot" Margin="0,8,0,2" />
                    <WrapPanel x:Name="PilotSwatchPanel" Orientation="Horizontal" />
                    <TextBlock Text="Related" Margin="0,8,0,2" />
                    <WrapPanel x:Name="RelatedSwatchPanel" Orientation="Horizontal" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Columns">
                <StackPanel Margin="12">
                    <ListBox x:Name="ColumnsListBox"
                             MaxHeight="220"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             DragOver="ColumnsListBox_DragOver"
                             Drop="ColumnsListBox_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="⠿"
                                               Width="20"
                                               VerticalAlignment="Center"
                                               Cursor="SizeAll"
                                               PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                               PreviewMouseMove="DragHandle_PreviewMouseMove" />
                                    <CheckBox Grid.Column="1"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsVisible}"
                                              IsEnabled="{Binding CanHide}"
                                              Checked="ColumnVisibility_Changed"
                                              Unchecked="ColumnVisibility_Changed" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="IgnoreListTabItem"
                     Header="Ignore List">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Ignore List" FontWeight="Bold" Margin="0,0,0,4" />
                        <DataGrid x:Name="IgnoreListDataGrid"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="70" />
                                <DataGridTemplateColumn Header="" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="x" Click="RemoveIgnoreEntry_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox x:Name="IgnoreEntryTextBox"
                                     Width="140"
                                     Margin="0,0,6,0"
                                     TextChanged="IgnoreEntryTextBox_TextChanged" />
                            <ComboBox x:Name="IgnoreTypeComboBox"
                                      Width="80"
                                      Margin="0,0,6,0"
                                      SelectionChanged="IgnoreTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Pilot" Tag="Pilot" />
                                <ComboBoxItem Content="Corp" Tag="Corporation" />
                                <ComboBoxItem Content="Alliance" Tag="Alliance" />
                            </ComboBox>
                            <Button Content="Add" Click="AddIgnoreEntry_Click" />
                        </StackPanel>
                        <TextBlock x:Name="IgnoreListMessageTextBlock"
                                   DockPanel.Dock="Top"
                                   Foreground="Red"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Text="List from Grid" FontWeight="Bold" Margin="0,4,0,4" />
                        <DataGrid x:Name="PilotsFromGridDataGrid"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="Cell"
                                  PreviewMouseLeftButtonUp="PilotsFromGridDataGrid_PreviewMouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ListFromGridPilotColumn" Header="Pilot" Binding="{Binding Pilot}" Width="*" />
                                <DataGridTextColumn x:Name="ListFromGridCorpColumn" Header="Corp" Binding="{Binding Corporation}" Width="*" />
                                <DataGridTextColumn x:Name="ListFromGridAllianceColumn" Header="Alliance" Binding="{Binding Alliance}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="DeveloperTabItem"
                     Header="Developer"
                     Visibility="Collapsed">
                <diagnostics:DiagnosticsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
