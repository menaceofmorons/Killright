<Window x:Class="Killright.UI.MenuModal.MenuModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillRight — Menu"
        Width="420"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="Ok_Click" />
            <Button Content="Cancel"
                    Width="80"
                    Click="Cancel_Click" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Config">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              Content="Always on top"
                              Checked="AlwaysOnTop_Changed"
                              Unchecked="AlwaysOnTop_Changed" />
                    <CheckBox x:Name="SkipBackupOnCloseCheckBox"
                              Content="Skip Backup on Close"
                              Margin="0,8,0,0"
                              Checked="SkipBackupOnClose_Changed"
                              Unchecked="SkipBackupOnClose_Changed" />
                    <Button Content="Reset to Defaults"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Click="ResetToDefaults_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
