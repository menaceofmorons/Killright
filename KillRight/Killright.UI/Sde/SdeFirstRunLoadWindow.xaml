<Window x:Class="Killright.UI.Sde.SdeFirstRunLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillRight — Loading Reference Data"
        Width="420"
        Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <Button x:Name="RetryButton"
                DockPanel.Dock="Bottom"
                Content="Retry"
                Width="80"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Click="Retry_Click" />
        <TextBlock x:Name="StageTextBlock"
                   DockPanel.Dock="Top"
                   Text="Checking manifest..."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <ProgressBar x:Name="DownloadProgressBar"
                     DockPanel.Dock="Top"
                     Height="18"
                     Minimum="0"
                     Maximum="1"
                     Visibility="Collapsed"
                     Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorTextBlock"
                   DockPanel.Dock="Top"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12" />
    </DockPanel>
</Window>
