<Window x:Class="Killright.UI.DeveloperTools.GroupDetectionHistoryPilot.GroupDetectionHistoryPilotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Detection Multi-Day History Import"
        Height="760"
        Width="1080"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Developer-only Historic Group Detection importer. Use the batch size selector to benchmark insert throughput with 500, 1000, 2000 and 5000 row batches."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Start UTC date:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="StartDateTextBox" Width="120" Margin="0,0,12,0" />

            <TextBlock Text="End UTC date:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EndDateTextBox" Width="120" Margin="0,0,12,0" />

            <TextBlock Text="Batch size:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="BatchSizeComboBox" Width="100" SelectedIndex="0" Margin="0,0,12,0">
                <ComboBoxItem Content="500" />
                <ComboBoxItem Content="1000" />
                <ComboBoxItem Content="2000" />
                <ComboBoxItem Content="5000" />
            </ComboBox>

            <Button x:Name="StartButton" Content="Import Date Range" Width="150" Height="32" Margin="0,0,8,0" Click="StartButton_Click" />
            <Button x:Name="CopyResultsButton" Content="Copy Results" Width="120" Height="32" IsEnabled="False" Click="CopyResultsButton_Click" />
        </StackPanel>

        <CheckBox Grid.Row="2"
                  x:Name="SeedModeCheckBox"
                  Content="Seed Mode: import evidence and participants only; do not update relationship summaries per day"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="3"
                   Text="Pilot instruction: run the same date range against a clean database once per batch size and compare evidenceExec, participantExec, dbTotal and total."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Text="Ready."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBox Grid.Row="5"
                 x:Name="ResultTextBox"
                 Text="Enter a UTC date range, select mode and batch size, then click Import Date Range."
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12" />
    </Grid>
</Window>