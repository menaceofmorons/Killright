<Window x:Class="Killright.UI.DeveloperTools.GroupDetectionHistoryPilot.GroupDetectionHistoryPilotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Detection Historic Updater"
        Height="420"
        Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Developer-only trigger for the Rust historic updater. This window starts the updater as a detached background process and displays whatever groupHistory.status.json currently reports. It performs no import or persistence itself."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="LaunchButton" Content="Launch Historic Updater" Width="180" Height="32" Margin="0,0,8,0" Click="LaunchButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh Status" Width="120" Height="32" Click="RefreshButton_Click" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="MessageTextBlock"
                   Text="Ready."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBox Grid.Row="3"
                 x:Name="StatusTextBox"
                 Text="Status unavailable."
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12" />
    </Grid>
</Window>
