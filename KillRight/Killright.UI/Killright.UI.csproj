<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <ApplicationIcon>Assets\killright.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Killright.Core\Killright.Core.csproj" />
      <ProjectReference Include="..\Killright.Integration\Killright.Integration.csproj" />
      <ProjectReference Include="..\Killright.Shared\Killright.Shared.csproj" />
      <ProjectReference Include="..\Killright.Storage\Killright.Storage.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <EngineTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(CARGO_TARGET_DIR)'))</EngineTargetDir>
        <EngineTargetDir Condition="'$(EngineTargetDir)' == ''">$(MSBuildThisFileDirectory)..\..\killright_engine\target\</EngineTargetDir>
        <EngineProfileDir Condition="'$(Configuration)' == 'Release'">release</EngineProfileDir>
        <EngineProfileDir Condition="'$(EngineProfileDir)' == ''">debug</EngineProfileDir>
    </PropertyGroup>

    <ItemGroup>
        <None Include="config\settings.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(EngineTargetDir)$(EngineProfileDir)\killright_engine.dll"
              Link="killright_engine.dll"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
