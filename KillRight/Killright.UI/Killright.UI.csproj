<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Killright.Core\Killright.Core.csproj" />
      <ProjectReference Include="..\Killright.Integration\Killright.Integration.csproj" />
      <ProjectReference Include="..\Killright.Shared\Killright.Shared.csproj" />
      <ProjectReference Include="..\Killright.Storage\Killright.Storage.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(NuGetPackageRoot)duckdb.net.bindings.full\1.5.3\runtimes\win-x64\native\duckdb.dll"
              Link="duckdb.dll"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="config\settings.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\killright_engine\config\recent-window.json"
              Link="config\recent-window.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\killright_engine\config\group-detection.json"
              Link="config\group-detection.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\killright_engine\target\debug\killright_engine.dll"
              Link="killright_engine.dll"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(HistoricRelationships)' != 'true'">
        <Compile Remove="DeveloperTools\GroupDetectionHistoryPilot\**" />
        <Page Remove="DeveloperTools\GroupDetectionHistoryPilot\**" />
    </ItemGroup>
    

</Project>
