<Window x:Class="Killright.UI.InfoSheet.InfoSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Killright.UI.Resources"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Deactivated="InfoSheetWindow_Deactivated">
    <Window.Resources>
        <Style x:Key="SheetTitleStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="Padding" Value="0,4,0,4" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Grid.Background}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="10">
        <StackPanel MinWidth="220">
            <Border Style="{StaticResource SheetTitleStyle}">
                <TextBlock Text="{Binding StatsTitle}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
            </Border>
            <TextBlock Text="{Binding ErrorLine}" Visibility="{Binding ErrorLineVisibility}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Threat.Red}" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelBirthday}" FontWeight="Bold" /><Run Text="{Binding BirthdayValue, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelThreat}" FontWeight="Bold" /><Run Text="{Binding ThreatValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelSec}" FontWeight="Bold" /><Run Text="{Binding SecValue, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelGeneral}" FontWeight="Bold" /><Run Text="{Binding GeneralValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelRecent}" FontWeight="Bold" /><Run Text="{Binding RecentValue, Mode=OneWay}" />
                </TextBlock>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static resources:UiText.InfoSheetTableKills}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static resources:UiText.InfoSheetTableSolos}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static resources:UiText.InfoSheetTableLosses}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resources:UiText.InfoSheetTableWeek}" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WeekKillsValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeekSolosValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WeekLossesValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resources:UiText.InfoSheetTableTotal}" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalKillsValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TotalSolosValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TotalLossesValue, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}" />
                </Grid>
            </Grid>

            <StackPanel Visibility="{Binding DeveloperFieldsVisibility}" Margin="0,6,0,0">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="Verify: " FontWeight="Bold" /><Run Text="{Binding VerifyValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="Notes: " FontWeight="Bold" /><Run Text="{Binding NotesValue, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Border Style="{StaticResource SheetTitleStyle}" Margin="0,10,0,0">
                <TextBlock Text="{x:Static resources:UiText.InfoSheetLabelLastActivityTitle}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
            </Border>
            <StackPanel Margin="0,4,0,0">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelDateTime}" FontWeight="Bold" /><Run Text="{Binding LastActivityDateTimeValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelKillLoss}" FontWeight="Bold" /><Run Text="{Binding LastActivityKillLossValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelSystem}" FontWeight="Bold" /><Run Text="{Binding LastActivitySystemValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelShip}" FontWeight="Bold" /><Run Text="{Binding LastActivityShipValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Visibility="{Binding LastActivityKillOnlyVisibility}" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelWeapon}" FontWeight="Bold" /><Run Text="{Binding LastActivityWeaponValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Visibility="{Binding LastActivityKillOnlyVisibility}" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelVictim}" FontWeight="Bold" /><Run Text="{Binding LastActivityVictimValue, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Visibility="{Binding LastActivityKillOnlyVisibility}" Foreground="{DynamicResource Brush.Text.Primary}">
                    <Run Text="{x:Static resources:UiText.InfoSheetLabelAttackers}" FontWeight="Bold" /><Run Text="{Binding LastActivityAttackersValue, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
