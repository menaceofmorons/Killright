<Window x:Class="Killright.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Killright.UI.Controls"
        xmlns:resources="clr-namespace:Killright.UI.Resources"
        Title="{x:Static resources:UiText.WindowTitleMain}"
        MinWidth="120"
        MinHeight="60"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window.Background}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Header.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Header.Text}" />
            <Setter Property="Height" Value="{DynamicResource GridHeaderHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ColumnHeaderStyleCentered" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnHeaderStyleRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CellStyleCentered" TargetType="DataGridCell" BasedOn="{StaticResource CellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PilotCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CellStyle}">
            <EventSetter Event="MouseEnter" Handler="PilotCell_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="PilotCell_MouseLeave" />
        </Style>
    </Window.Resources>
    <Grid Margin="2,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                 Grid.Row="0"
                                                 CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Orientation="Horizontal"
                                   Height="10"
                                   MinHeight="0"
                                   Background="Transparent"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}">
                            <ScrollBar.Template>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track"
                                           Orientation="Horizontal"
                                           IsDirectionReversed="False"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}"
                                           ViewportSize="{TemplateBinding ViewportSize}">
                                        <Track.Thumb>
                                            <Thumb shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource Brush.Border}"
                                                                Height="3"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="1.5" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </ScrollBar.Template>
                        </ScrollBar>
                    </Grid>
                </ControlTemplate>
            </ScrollViewer.Template>
            <DataGrid x:Name="PilotGrid"
                      ItemsSource="{Binding Pilots}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="{DynamicResource Brush.Grid.Background}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      RowHeight="{DynamicResource GridRowHeight}"
                      FontSize="{DynamicResource GridFontSize}"
                      ColumnDisplayIndexChanged="PilotGrid_ColumnDisplayIndexChanged"
                      PreviewMouseRightButtonUp="PilotGrid_PreviewMouseRightButtonUp"
                      PreviewMouseLeftButtonDown="PilotGrid_PreviewMouseLeftButtonDown"
                      ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                      CellStyle="{StaticResource CellStyle}">
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Width" Value="10" />
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track"
                                                   Orientation="Vertical"
                                                   IsDirectionReversed="True"
                                                   Minimum="{TemplateBinding Minimum}"
                                                   Maximum="{TemplateBinding Maximum}"
                                                   Value="{TemplateBinding Value}"
                                                   ViewportSize="{TemplateBinding ViewportSize}">
                                                <Track.Thumb>
                                                    <Thumb shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{DynamicResource Brush.Border}"
                                                                        Width="3"
                                                                        HorizontalAlignment="Center"
                                                                        CornerRadius="1.5" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource Brush.Grid.Background}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHighlight}" Value="True">
                                <Setter Property="Background" Value="{Binding HighlightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColumnThreat" Header="{x:Static resources:UiText.GridColumnHeaderThreat}" Width="50" SortMemberPath="Threat" HeaderStyle="{StaticResource ColumnHeaderStyleCentered}" CellStyle="{StaticResource CellStyleCentered}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:ThreatGlyph Band="{Binding Threat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColumnPilot" Header="{x:Static resources:UiText.GridColumnHeaderPilot}" Binding="{Binding Pilot}" Width="170" CellStyle="{StaticResource PilotCellStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineAnalysisFailed}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn x:Name="ColumnRelationship" Header="{x:Static resources:UiText.GridColumnHeaderRelationship}" Width="60" CanUserSort="False" HeaderStyle="{StaticResource ColumnHeaderStyleCentered}" CellStyle="{StaticResource CellStyleCentered}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RelationshipStrengthDisplay}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <controls:ConfidenceGlyph Confidence="{Binding RelationshipConfidenceBand}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColumnStyle" Header="{x:Static resources:UiText.GridColumnHeaderStyle}" Binding="{Binding Style}" Width="60" HeaderStyle="{StaticResource ColumnHeaderStyleCentered}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColumnSecurityStatus" Header="{x:Static resources:UiText.GridColumnHeaderSec}" Binding="{Binding SecurityStatus}" Width="70" HeaderStyle="{StaticResource ColumnHeaderStyleRight}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColumnWeek" Header="{x:Static resources:UiText.GridColumnHeaderWeek}" Binding="{Binding Week}" Width="60" HeaderStyle="{StaticResource ColumnHeaderStyleCentered}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColumnCorporation" Header="{x:Static resources:UiText.GridColumnHeaderCorporation}" Binding="{Binding Corporation}" Width="210" />
                    <DataGridTextColumn x:Name="ColumnAlliance" Header="{x:Static resources:UiText.GridColumnHeaderAlliance}" Binding="{Binding Alliance}" Width="210" />
                    <DataGridTextColumn x:Name="ColumnLastActive" Header="{x:Static resources:UiText.GridColumnHeaderLastKill}" Binding="{Binding LastKill}" Width="90" />
                    <DataGridTextColumn x:Name="ColumnNotes" Header="{x:Static resources:UiText.GridColumnHeaderNotes}" Binding="{Binding Notes}" Width="260" />
                    <DataGridTextColumn x:Name="ColumnVerify" Header="{x:Static resources:UiText.GridColumnHeaderVerify}" Binding="{Binding Verify}" Width="70" />
                    <DataGridTextColumn x:Name="ColumnGroup" Header="{x:Static resources:UiText.GridColumnHeaderGroup}" Binding="{Binding Group}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Window>
